# انسخ هذا الملف إلى .env.local للتشغيل المحلي
# على Vercel: أضف نفس المتغيرات في Project Settings → Environment Variables

# اسم المستخدم للوحة التحكم (مطلوب)
ADMIN_USERNAME=admin

# كلمة المرور للوحة التحكم (مطلوبة عند أول تشغيل — يمكن تغييرها لاحقًا من اللوحة)
ADMIN_PASSWORD=

# مفتاح توقيع الجلسات (اختياري — يُولَّد تلقائيًا ويُخزَّن في قاعدة البيانات إن تُرك فارغًا)
SESSION_SECRET=

# قاعدة Turso (libSQL) — الخيار الأول للإنتاج:
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# أو ضع الرابط نفسه في DATABASE_URL يبدأ بـ libsql:// والتوكن في DATABASE_AUTH_TOKEN (يدعم تلقائيًا)
# أو رابط Postgres (Neon / Supabase) يبدأ بـ postgres:// — يستخدم سائق pg
# إن تُرك كلها فارغة سيستخدم الموقع قاعدة SQLite محلية في مجلد data/ (مناسبة للتطوير فقط)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# رابط الموقع العام (اختياري — يستخدم في SEO وسitemap، ويُستنتج تلقائيًا إن تُرك فارغًا)
NEXT_PUBLIC_SITE_URL=
